      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحفظ PastePoint الصور ومقاطع الفيديو التي تستلمها في مكتبة صورك."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PastePoint saves photos and videos you receive to your photo library."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PastePoint guarda en tu fototeca las fotos y vídeos que recibes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PastePoint enregistre dans votre photothèque les photos et vidéos que vous recevez."
