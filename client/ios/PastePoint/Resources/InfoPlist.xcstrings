    "NSCameraUsageDescription" : {
      "comment" : "Permission prompt shown when requesting camera access (QR code scanning).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم PastePoint الكاميرا لمسح رموز QR للانضمام إلى الجلسات الخاصة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PastePoint uses the camera to scan QR codes for joining private sessions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PastePoint usa la cámara para escanear códigos QR y unirse a sesiones privadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PastePoint utilise la caméra pour scanner les codes QR afin de rejoindre des sessions privées."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PastePoint использует камеру для сканирования QR-кодов, чтобы присоединяться к приватным сессиям."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Permission prompt shown when requesting Local Network access.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج PastePoint إلى الوصول إلى الشبكة المحلية للاتصال بالخادم على شبكتك."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PastePoint needs local network access to connect to the server on your network."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PastePoint necesita acceso a la red local para conectarse al servidor de tu red."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PastePoint a besoin d'accéder au réseau local pour se connecter au serveur de votre réseau."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PastePoint требуется доступ к локальной сети для подключения к серверу в вашей сети."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Permission prompt shown when saving received photos/videos to the photo library.",
