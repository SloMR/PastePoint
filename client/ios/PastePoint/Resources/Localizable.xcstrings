        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PastePoint needs camera access to scan QR codes. Enable it in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PastePoint necesita acceso a la cámara para escanear códigos QR. Actívalo en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PastePoint a besoin d'accéder à la caméra pour scanner les codes QR. Activez-le dans Réglages."
