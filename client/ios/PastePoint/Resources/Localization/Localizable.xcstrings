    "CAMERA_ACCESS_MESSAGE" : {
      "comment" : "Message shown when camera permission is denied.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج PastePoint إلى إذن الكاميرا لمسح رموز QR. فعّله من الإعدادات."
          }
