    },
    "LEGAL_GATE_MESSAGE" : {
      "comment" : "Body text of the first-launch terms acceptance gate.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يربط PastePoint أجهزتك مباشرةً لمشاركة الرسائل والملفات."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PastePoint connects your devices directly to share messages and files."
          }
        },
        "es" : {
          "stringUnit" : {
