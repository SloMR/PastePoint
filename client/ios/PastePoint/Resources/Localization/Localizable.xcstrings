    "LEGAL_GATE_ZERO_TOLERANCE" : {
      "comment" : "Zero-tolerance notice on the first-launch terms gate, required by App Review guideline 1.2.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا نتسامح إطلاقًا مع المحتوى المرفوض أو المستخدمين المسيئين. يمكنك حظر أي شخص في المحادثة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There is zero tolerance for objectionable content or abusive users. You can block anyone in a chat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se tolera el contenido objetable ni los usuarios abusivos. Puedes bloquear a cualquier persona en un chat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune tolérance envers les contenus répréhensibles ou les utilisateurs abusifs. Vous pouvez bloquer toute personne dans une discussion."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нулевая терпимость к неприемлемому контенту и злоупотребляющим пользователям. Вы можете заблокировать любого участника чата."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们对令人反感的内容和滥用行为的用户采取零容忍政策。您可以屏蔽聊天中的任何人。"
          }
        }
      }
    },
