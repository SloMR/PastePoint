    "OPTION_ELSEWHERE_BODY" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هاتف على بيانات الجوال، أو شخص في مكان آخر؟ أنشئ رابطًا يمكن فتحه من أي مكان."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phone on mobile data, or someone somewhere else? Create a link they can open from anywhere."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Un teléfono con datos móviles o alguien en otro lugar? Crea un enlace que puedan abrir desde cualquier sitio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un téléphone en données mobiles, ou quelqu’un ailleurs ? Créez un lien qu’il pourra ouvrir de n’importe où."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Телефон на мобильном интернете или кто-то в другом месте? Создайте ссылку, которую можно открыть откуда угодно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手机使用移动数据，或对方在别处？创建一个可在任何地方打开的链接。"
          }
        }
      }
    },
    "OPTION_ELSEWHERE_BODY_CONNECTED" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنشئ رابطًا يمكن لشخص على شبكة أخرى فتحه. ستنتقل إلى غرفة خاصة جديدة — لن تتبعك الأجهزة الموجودة على هذه الشبكة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create a link someone on another network can open. You’ll move to a new private room — devices on this Wi-Fi won’t follow."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea un enlace que alguien en otra red pueda abrir. Pasarás a una sala privada nueva: los dispositivos de esta Wi-Fi no te seguirán."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créez un lien qu’une personne sur un autre réseau pourra ouvrir. Vous passerez dans un nouveau salon privé — les appareils de ce Wi-Fi ne suivront pas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создайте ссылку, которую откроет кто-то из другой сети. Вы перейдёте в новую приватную комнату — устройства в этой сети Wi-Fi за вами не последуют."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "创建一个其他网络的人可以打开的链接。你将进入一个新的私密房间——此 Wi-Fi 下的设备不会跟随。"
          }
        }
      }
    },
    "OPTION_ELSEWHERE_TITLE" : {
      "extractionState" : "manual",
      "localizations" : {
