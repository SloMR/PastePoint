    "@angular/platform-browser": "^22.1.7",
    "@angular/platform-server": "^22.1.7",
    "@angular/router": "^22.1.7",
    "@angular/ssr": "^22.1.8",
    "@ngx-translate/core": "^18.0.0",
    "@ngxpert/hot-toast": "^7.0.0",
    "@sentry/angular": "^10.75.2",
    "async-mutex": "^0.5.0",
    "autolinker": "^4.1.5",
