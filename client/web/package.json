{
  "name": "web",
  "version": "0.25.3",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start-local": "ng serve --host 0.0.0.0",
    "build": "ng build",
    "build:dev": "ng build --configuration=development",
    "build:prod": "ng build --configuration=production",
    "watch": "ng build --watch",
    "test": "ng test",
    "serve:ssr:web": "node dist/web/server/server.mjs",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "format": "prettier --write .",
    "test:coverage": "ng test --code-coverage",
    "acknowledgements": "node ../../scripts/acknowledgements/generate-web-acknowledgements.mjs",
    "acknowledgements:check": "node ../../scripts/acknowledgements/generate-web-acknowledgements.mjs --check",
    "test:ci": "ng test --no-watch --code-coverage --browsers=ChromeHeadless"
  },
  "private": true,
  "type": "module",
  "dependencies": {
    "@angular/cdk": "^22.1.7",
    "@angular/common": "^22.1.7",
    "@angular/compiler": "^22.1.7",
